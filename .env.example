# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Your Supabase anon/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Mode Configuration
# Set to 'true' to use mock data instead of Supabase (perfect for demos/testing)
# When enabled, no database connection is needed and all data is stored in memory
NEXT_PUBLIC_DEMO_MODE=false

# Observation ingest API
# Generate a long random value and send it as: Authorization: Bearer <token>
OBSERVATIONS_TOKEN=change-me

# Server-only Supabase key used by /api/observations.
# Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Release document synthesis
# Server-only Anthropic credentials used by /api/release-documents/generate.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
